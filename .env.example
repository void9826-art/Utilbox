# Copy to .env.local and fill in what you need. Every value is optional — the
# site runs without any of them, and every tool except the currency converter
# works with no network at all.

# ---------------------------------------------------------------------------
# Branding and deployment
# ---------------------------------------------------------------------------

# The canonical origin, used for canonical URLs, Open Graph tags, the sitemap
# and robots.txt. On Vercel this is inferred from the deployment; set it
# explicitly once you have a custom domain.
NEXT_PUBLIC_SITE_URL=https://www.utilboxes.xyz

# Rebrand without touching a component.
NEXT_PUBLIC_SITE_NAME=Utilboxes
NEXT_PUBLIC_SITE_SHORT_NAME=Utilboxes

# ---------------------------------------------------------------------------
# Legal and contact details, shown on /privacy, /terms, /cookies and /contact
# ---------------------------------------------------------------------------

NEXT_PUBLIC_LEGAL_ENTITY=Example Ltd
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_POSTAL_ADDRESS=

# Used for the Twitter/X card byline. Leave blank to omit it.
NEXT_PUBLIC_TWITTER_HANDLE=

# ---------------------------------------------------------------------------
# Advertising (Google AdSense)
# ---------------------------------------------------------------------------
# Without a publisher id no ad markup is emitted at all: slots render as a
# dashed outline in development and disappear entirely in production, so the
# live page never carries a permanent empty gap.

NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Leave blank and no analytics script is loaded. When set, only page views and
# coarse events are recorded — never file names, file contents, extracted text
# or anything typed into a tool. See src/lib/analytics.ts for the whole surface.

NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Exchange rates (the currency converter only)
# ---------------------------------------------------------------------------
# By default rates come from the European Central Bank's daily reference feed
# via Frankfurter, which needs no key. Set a key to switch to a paid provider;
# it stays on the server and is never sent to the browser.

# EXCHANGE_RATE_PROVIDER=frankfurter
# EXCHANGE_RATE_API_KEY=
